import asyncio

class StoreError(Exception): ...

class Store:
    @property
    def backend(self) -> str: ...
    def ping(self) -> asyncio.Future[int]: ...
    def session_settings(self) -> asyncio.Future[list[str]]: ...
    def spike_reset(self) -> asyncio.Future[None]: ...
    def spike_hold_transaction(self, seconds: float) -> asyncio.Future[None]: ...
    def spike_rows(self) -> asyncio.Future[int]: ...
    def spike_open_transactions(self) -> asyncio.Future[int | None]: ...
    def connections_in_use(self) -> int: ...

def connect(url: str) -> asyncio.Future[Store]: ...
